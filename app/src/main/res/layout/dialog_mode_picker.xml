<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="210dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_popup_dark"
    tools:ignore="DuplicateIds"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="选择对战模式"
        android:textSize="13sp"
        android:textColor="#E6B36A"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- 双人对战 -->
    <LinearLayout
        android:id="@+id/mode_card_0"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_mode_card_dark"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <View
            android:id="@+id/mode_card_accent"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#E6B36A" />

        <CustomView.ModeComboView
            android:id="@+id/mode_card_glyph_left"
            android:layout_width="34dp"
            android:layout_height="34dp" />

        <TextView
            android:id="@+id/mode_card_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="双人对战"
            android:textSize="15sp"
            android:textColor="#F1DAA8" />

        <CustomView.ModeComboView
            android:id="@+id/mode_card_glyph_right"
            android:layout_width="34dp"
            android:layout_height="34dp" />

        <ImageView
            android:id="@+id/mode_card_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_check"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#557A6040"
        android:layout_marginBottom="4dp" />

    <!-- 玩家执红 -->
    <LinearLayout
        android:id="@+id/mode_card_1"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_mode_card_dark"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <View
            android:id="@+id/mode_card_accent"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#E6B36A" />

        <CustomView.ModeComboView
            android:id="@+id/mode_card_glyph_left"
            android:layout_width="34dp"
            android:layout_height="34dp" />

        <TextView
            android:id="@+id/mode_card_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="玩家执红"
            android:textSize="15sp"
            android:textColor="#F1DAA8" />

        <CustomView.ModeComboView
            android:id="@+id/mode_card_glyph_right"
            android:layout_width="34dp"
            android:layout_height="34dp" />

        <ImageView
            android:id="@+id/mode_card_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_check"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#557A6040"
        android:layout_marginBottom="4dp" />

    <!-- 玩家执黑 -->
    <LinearLayout
        android:id="@+id/mode_card_2"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_mode_card_dark"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <View
            android:id="@+id/mode_card_accent"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#E6B36A" />

        <CustomView.ModeComboView
            android:id="@+id/mode_card_glyph_left"
            android:layout_width="34dp"
            android:layout_height="34dp" />

        <TextView
            android:id="@+id/mode_card_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="玩家执黑"
            android:textSize="15sp"
            android:textColor="#F1DAA8" />

        <CustomView.ModeComboView
            android:id="@+id/mode_card_glyph_right"
            android:layout_width="34dp"
            android:layout_height="34dp" />

        <ImageView
            android:id="@+id/mode_card_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_check"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#557A6040"
        android:layout_marginBottom="4dp" />

    <!-- 双机对战 -->
    <LinearLayout
        android:id="@+id/mode_card_3"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_mode_card_dark"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <View
            android:id="@+id/mode_card_accent"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#E6B36A" />

        <CustomView.ModeComboView
            android:id="@+id/mode_card_glyph_left"
            android:layout_width="34dp"
            android:layout_height="34dp" />

        <TextView
            android:id="@+id/mode_card_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="双机对战"
            android:textSize="15sp"
            android:textColor="#F1DAA8" />

        <CustomView.ModeComboView
            android:id="@+id/mode_card_glyph_right"
            android:layout_width="34dp"
            android:layout_height="34dp" />

        <ImageView
            android:id="@+id/mode_card_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_check"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#557A6040"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <!-- 取消 -->
    <Button
        android:id="@+id/mode_cancel"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_mode_cancel_btn_dark"
        android:text="取  消"
        android:textSize="13sp"
        android:textColor="#C9B48A"
        android:letterSpacing="0.2" />

</LinearLayout>
