<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_popup"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="2dp"
    android:paddingBottom="6dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="选择对战模式"
        android:textSize="13sp"
        android:textColor="#1A1A1A"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <!-- 双人对战 -->
    <LinearLayout
        android:id="@+id/mode_card_0"
        android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="4dp"
        android:background="@drawable/bg_mode_card"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <View
            android:id="@+id/mode_card_accent"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:background="#CCCCCC" />

        <CustomView.ModeComboView
            android:id="@+id/mode_card_glyph_left"
                android:layout_width="36dp"
                android:layout_height="36dp" />

        <TextView
            android:id="@+id/mode_card_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="双人对战"
            android:textSize="15sp"
            android:textColor="#222222" />

        <CustomView.ModeComboView
            android:id="@+id/mode_card_glyph_right"
                android:layout_width="36dp"
                android:layout_height="36dp" />

        <ImageView
            android:id="@+id/mode_card_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_check"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 玩家执红 -->
    <LinearLayout
        android:id="@+id/mode_card_1"
        android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="4dp"
        android:background="@drawable/bg_mode_card"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <View
            android:id="@+id/mode_card_accent"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:background="#CCCCCC" />

        <CustomView.ModeComboView
            android:id="@+id/mode_card_glyph_left"
                android:layout_width="36dp"
                android:layout_height="36dp" />

        <TextView
            android:id="@+id/mode_card_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="玩家执红"
            android:textSize="15sp"
            android:textColor="#222222" />

        <CustomView.ModeComboView
            android:id="@+id/mode_card_glyph_right"
                android:layout_width="36dp"
                android:layout_height="36dp" />

        <ImageView
            android:id="@+id/mode_card_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_check"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 玩家执黑 -->
    <LinearLayout
        android:id="@+id/mode_card_2"
        android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="4dp"
        android:background="@drawable/bg_mode_card"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <View
            android:id="@+id/mode_card_accent"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:background="#CCCCCC" />

        <CustomView.ModeComboView
            android:id="@+id/mode_card_glyph_left"
                android:layout_width="36dp"
                android:layout_height="36dp" />

        <TextView
            android:id="@+id/mode_card_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="玩家执黑"
            android:textSize="15sp"
            android:textColor="#222222" />

        <CustomView.ModeComboView
            android:id="@+id/mode_card_glyph_right"
                android:layout_width="36dp"
                android:layout_height="36dp" />

        <ImageView
            android:id="@+id/mode_card_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_check"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 双机对战 -->
    <LinearLayout
        android:id="@+id/mode_card_3"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_mode_card"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <View
            android:id="@+id/mode_card_accent"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:background="#CCCCCC" />

        <CustomView.ModeComboView
            android:id="@+id/mode_card_glyph_left"
                android:layout_width="36dp"
                android:layout_height="36dp" />

        <TextView
            android:id="@+id/mode_card_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="双机对战"
            android:textSize="15sp"
            android:textColor="#222222" />

        <CustomView.ModeComboView
            android:id="@+id/mode_card_glyph_right"
                android:layout_width="36dp"
                android:layout_height="36dp" />

        <ImageView
            android:id="@+id/mode_card_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_check"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 取消 -->
    <Button
        android:id="@+id/mode_cancel"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="@drawable/bg_mode_cancel_btn"
        android:text="取  消"
        android:textSize="13sp"
        android:textColor="#888888"
        android:letterSpacing="0.2" />

</LinearLayout>
