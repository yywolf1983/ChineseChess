<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="16dp">

    <!-- 顶部把手 -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#DDDDDD" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="选择对战模式"
        android:textSize="16sp"
        android:textColor="#1A1A1A"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="14dp" />

    <!-- 双人对战 -->
    <LinearLayout
        android:id="@+id/mode_card_0"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_mode_card"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <View
            android:id="@+id/mode_card_accent"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:background="#CCCCCC" />

        <CustomView.ModeComboView
            android:id="@+id/mode_card_glyph"
            android:layout_width="52dp"
            android:layout_height="30dp" />

        <TextView
            android:id="@+id/mode_card_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="双人对战"
            android:textSize="16sp"
            android:textColor="#222222" />

        <ImageView
            android:id="@+id/mode_card_check"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 人机对战（玩家红） -->
    <LinearLayout
        android:id="@+id/mode_card_1"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_mode_card"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <View
            android:id="@+id/mode_card_accent"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:background="#CCCCCC" />

        <CustomView.ModeComboView
            android:id="@+id/mode_card_glyph"
            android:layout_width="52dp"
            android:layout_height="30dp" />

        <TextView
            android:id="@+id/mode_card_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="人机对战(玩家红)"
            android:textSize="16sp"
            android:textColor="#222222" />

        <ImageView
            android:id="@+id/mode_card_check"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 人机对战（玩家黑） -->
    <LinearLayout
        android:id="@+id/mode_card_2"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_mode_card"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <View
            android:id="@+id/mode_card_accent"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:background="#CCCCCC" />

        <CustomView.ModeComboView
            android:id="@+id/mode_card_glyph"
            android:layout_width="52dp"
            android:layout_height="30dp" />

        <TextView
            android:id="@+id/mode_card_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="人机对战(玩家黑)"
            android:textSize="16sp"
            android:textColor="#222222" />

        <ImageView
            android:id="@+id/mode_card_check"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 双机对战 -->
    <LinearLayout
        android:id="@+id/mode_card_3"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_mode_card"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <View
            android:id="@+id/mode_card_accent"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:background="#CCCCCC" />

        <CustomView.ModeComboView
            android:id="@+id/mode_card_glyph"
            android:layout_width="52dp"
            android:layout_height="30dp" />

        <TextView
            android:id="@+id/mode_card_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="双机对战"
            android:textSize="16sp"
            android:textColor="#222222" />

        <ImageView
            android:id="@+id/mode_card_check"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 取消 -->
    <Button
        android:id="@+id/mode_cancel"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_mode_cancel_btn"
        android:text="取  消"
        android:textSize="15sp"
        android:textColor="#888888"
        android:letterSpacing="0.2" />

</LinearLayout>
