<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/button_group"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/control_panel_ui"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_control_panel"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="10dp">

        <!-- 剩下的按钮放在一行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:weightSum="5.8"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btn_flip"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginLeft="1dp"
                android:layout_marginRight="1dp"
                android:background="@drawable/bg_board_btn_nav_flip"
                android:gravity="center"
                android:contentDescription="翻转" />

            <Button
                android:id="@+id/btn_setup"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.6"
                android:layout_marginLeft="1dp"
                android:layout_marginRight="1dp"
                android:background="@drawable/bg_board_btn_setup"
                android:drawableTop="@drawable/ic_setup"
                android:drawablePadding="-2dp"
                android:text="摆棋"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_recall"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.6"
                android:layout_marginLeft="1dp"
                android:layout_marginRight="1dp"
                android:background="@drawable/bg_board_btn_recall"
                android:drawableTop="@drawable/ic_recall"
                android:drawablePadding="-2dp"
                android:text="悔棋"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_statistics"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.6"
                android:layout_marginLeft="1dp"
                android:layout_marginRight="1dp"
                android:background="@drawable/bg_board_btn_suggest"
                android:drawableTop="@drawable/ic_suggest"
                android:drawablePadding="-2dp"
                android:text="支招"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 隐藏按钮（保留用于业务逻辑：点击菜单项时触发其监听） -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="0dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_board_btn_primary"
                android:drawableTop="@drawable/ic_new_game"
                android:text="新局"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_board_btn_settings"
                android:drawableTop="@drawable/ic_settings"
                android:text="设置"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_board_btn_save"
                android:drawableTop="@drawable/ic_save"
                android:text="保存"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_load"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_board_btn_nav"
                android:drawableTop="@drawable/ic_load"
                android:text="加载"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/btn_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_board_btn_mode"
                android:gravity="center">

                <ImageView
                    android:id="@+id/mode_icon_left"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_mode" />

                <TextView
                    android:id="@+id/mode_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="模式"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/mode_icon_right"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="1dp"
                    android:src="@drawable/ic_mode" />
            </LinearLayout>
        </LinearLayout>

        <!-- 评分曲线背景框（含提示盒） -->
        <FrameLayout
            android:id="@+id/score_curve_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_engine_box"
            android:layout_marginTop="0dp"
            android:padding="1dp">

            <CustomView.ScoreCurveView
                android:id="@+id/score_curve_view"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="center" />

            <ScrollView
                android:id="@+id/engine_result_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="vertical"
                android:fadeScrollbars="false"
                android:scrollbarThumbVertical="@drawable/scrollbar_thumb_vertical"
                android:scrollbarSize="0.5dp"
                android:layout_gravity="bottom">

                <LinearLayout
                    android:id="@+id/engine_result_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="1dp" />
                </ScrollView>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
