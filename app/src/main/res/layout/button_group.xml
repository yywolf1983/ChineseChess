<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/button_group"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="0dp">

    <!-- 控制面板：包裹两行按钮，与下方评分曲线同款深色材质，消除与棋盘的割裂感 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_control_panel"
        android:padding="8dp"
        android:orientation="vertical">

    <!-- 第1行：常用操作（前四个纯文字，后三个纯图标，恢复原始排版） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="7">

        <Button
            android:id="@+id/btn_retry"
            android:soundEffectsEnabled="false"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minHeight="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_board_btn_primary"
            android:paddingVertical="3dp"
            android:textSize="13sp"
            android:gravity="center"
            android:text="新局"
            android:textColor="#2E2018"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_settings"
            android:soundEffectsEnabled="false"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minHeight="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_board_btn_settings"
            android:paddingVertical="3dp"
            android:textSize="13sp"
            android:gravity="center"
            android:text="设置"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_save"
            android:soundEffectsEnabled="false"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minHeight="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_board_btn_save"
            android:paddingVertical="3dp"
            android:textSize="13sp"
            android:gravity="center"
            android:text="保存"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_load"
            android:soundEffectsEnabled="false"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minHeight="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_board_btn_primary"
            android:paddingVertical="3dp"
            android:textSize="13sp"
            android:gravity="center"
            android:text="加载"
            android:textColor="#2E2018"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_prev"
            android:soundEffectsEnabled="false"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minHeight="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_board_btn_nav_prev"
            android:textSize="13sp"
            android:gravity="center"
            android:text=""
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_next"
            android:soundEffectsEnabled="false"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minHeight="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_board_btn_nav_next"
            android:textSize="13sp"
            android:gravity="center"
            android:text=""
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_flip"
            android:soundEffectsEnabled="false"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minHeight="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_board_btn_nav_flip"
            android:textSize="13sp"
            android:gravity="center"
            android:text=""
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 第2行：功能工具（图标 + 文字，与第1行统一排版） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:weightSum="4">

        <LinearLayout
            android:id="@+id/btn_mode"
            android:soundEffectsEnabled="false"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minHeight="0dp"
            android:layout_weight="1.15"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_board_btn_mode"
            android:paddingVertical="3dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/mode_icon_left"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="3dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/mode_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:text="模式" />

            <ImageView
                android:id="@+id/mode_icon_right"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="3dp"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_setup"
            android:soundEffectsEnabled="false"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minHeight="0dp"
            android:layout_weight="0.85"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_board_btn_setup"
            android:drawableTop="@drawable/ic_setup"
            android:drawableTint="#FFFFFF"
            android:drawablePadding="2dp"
            android:paddingVertical="3dp"
            android:textSize="13sp"
            android:gravity="center"
            android:text="摆棋"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_recall"
            android:soundEffectsEnabled="false"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minHeight="0dp"
            android:layout_weight="0.85"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_board_btn_recall"
            android:drawableTop="@drawable/ic_recall"
            android:drawableTint="#FFFFFF"
            android:drawablePadding="2dp"
            android:paddingVertical="3dp"
            android:textSize="13sp"
            android:gravity="center"
            android:text="悔棋"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_statistics"
            android:soundEffectsEnabled="false"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minHeight="0dp"
            android:layout_weight="1.15"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_board_btn_suggest_green"
            android:drawableTop="@drawable/ic_suggest"
            android:drawableTint="#FFFFFF"
            android:drawablePadding="2dp"
            android:paddingVertical="3dp"
            android:textSize="13sp"
            android:gravity="center"
            android:text="支招"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 底部区域：评分曲线（背景层） + 引擎结果提示盒（浮于其上）。 -->
    <FrameLayout
        android:id="@+id/score_curve_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <!-- 整局评分曲线（背景层，始终可见） -->
        <CustomView.ScoreCurveView
            android:id="@+id/score_curve_view"
            android:layout_width="match_parent"
            android:layout_height="100dp" />

        <!-- 引擎计算结果展示框：默认隐藏，支招结果到达时显示 -->
        <ScrollView
            android:id="@+id/engine_result_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:background="@drawable/bg_engine_box"
            android:scrollbars="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/engine_result_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="0dp" />
        </ScrollView>
    </FrameLayout>
    </LinearLayout>

</LinearLayout>
