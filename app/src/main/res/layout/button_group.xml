<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/button_group"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="0dp">

    <!-- 第1行：常用操作（新局/设置/保存/加载 文字，上一步/下一步/翻转 图标） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="7">

        <Button
            android:id="@+id/btn_retry"
            android:soundEffectsEnabled="false"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:minHeight="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_board_btn_primary"
            android:textSize="14sp"
            android:gravity="center"
            android:text="新局"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_settings"
            android:soundEffectsEnabled="false"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:minHeight="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_board_btn_settings"
            android:textSize="14sp"
            android:gravity="center"
            android:text="设置"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_save"
            android:soundEffectsEnabled="false"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:minHeight="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_board_btn_save"
            android:textSize="14sp"
            android:gravity="center"
            android:text="保存"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_load"
            android:soundEffectsEnabled="false"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:minHeight="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_board_btn_primary"
            android:textSize="14sp"
            android:gravity="center"
            android:text="加载"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_prev"
            android:soundEffectsEnabled="false"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:minHeight="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_board_btn_nav_prev"
            android:gravity="center" />

        <Button
            android:id="@+id/btn_next"
            android:soundEffectsEnabled="false"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:minHeight="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_board_btn_nav_next"
            android:gravity="center" />

        <Button
            android:id="@+id/btn_flip"
            android:soundEffectsEnabled="false"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:minHeight="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_board_btn_nav_flip"
            android:gravity="center" />
    </LinearLayout>

    <!-- 第2行：功能工具（保持原样式：图标 + 文字，与第1行保留微距） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal"
        android:weightSum="4">

        <Button
            android:id="@+id/btn_mode"
            android:soundEffectsEnabled="false"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:minHeight="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_board_btn_mode"
            android:drawableTop="@drawable/ic_mode"
            android:drawableTint="#FFFFFF"
            android:drawablePadding="0dp"
            android:textSize="13sp"
            android:gravity="center"
            android:text="模式"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_setup"
            android:soundEffectsEnabled="false"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:minHeight="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_board_btn_setup"
            android:drawableTop="@drawable/ic_setup"
            android:drawableTint="#FFFFFF"
            android:drawablePadding="0dp"
            android:textSize="13sp"
            android:gravity="center"
            android:text="摆棋"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_recall"
            android:soundEffectsEnabled="false"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:minHeight="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_board_btn_recall"
            android:drawableTop="@drawable/ic_recall"
            android:drawableTint="#FFFFFF"
            android:drawablePadding="0dp"
            android:textSize="13sp"
            android:gravity="center"
            android:text="悔棋"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_statistics"
            android:soundEffectsEnabled="false"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:minHeight="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_board_btn_suggest_teal"
            android:drawableTop="@drawable/ic_suggest"
            android:drawableTint="#FFFFFF"
            android:drawablePadding="0dp"
            android:textSize="13sp"
            android:gravity="center"
            android:text="支招"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 底部区域：评分曲线（背景层） + 引擎结果提示盒（浮于其上）。
         提示盒默认隐藏，显示时覆盖曲线（半透明背景使曲线透出在后面）；提示消失后曲线重新露出。 -->
    <FrameLayout
        android:id="@+id/score_curve_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <!-- 整局评分曲线（背景层，始终可见） -->
        <CustomView.ScoreCurveView
            android:id="@+id/score_curve_view"
            android:layout_width="match_parent"
            android:layout_height="72dp" />

        <!-- 引擎计算结果展示框：默认隐藏，支招结果到达时显示；
             每行一条独立候选变线（单行、可横向滑动、不折行），整体可竖向滚动 -->
        <ScrollView
            android:id="@+id/engine_result_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:background="@drawable/bg_engine_box"
            android:scrollbars="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/engine_result_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="0dp" />
        </ScrollView>
    </FrameLayout>

</LinearLayout>
