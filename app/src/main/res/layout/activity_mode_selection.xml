<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="#FAFAFA">

    <!-- 顶部标题区 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="28dp"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏁"
            android:textSize="40sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="中国象棋"
            android:textSize="26sp"
            android:textColor="#1A1A1A"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择对战模式"
            android:textSize="13sp"
            android:textColor="#AAAAAA"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- 当前模式标签 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mode_cancel_btn"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:layout_marginBottom="24dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前 · "
            android:textSize="12sp"
            android:textColor="#AAAAAA" />

        <TextView
            android:id="@+id/current_mode_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="双人对战"
            android:textSize="12sp"
            android:textColor="#666666"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 分区标题: 人机对战 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="人  机  对  战"
        android:textSize="11sp"
        android:textColor="#BBBBBB"
        android:letterSpacing="0.2"
        android:gravity="center"
        android:layout_marginBottom="10dp" />

    <!-- 人机对战（玩家红） -->
    <LinearLayout
        android:id="@+id/mode_1_button"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_mode_pvai_red"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="人机对战（玩家红）"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶"
            android:textSize="14sp"
            android:textColor="#88FFFFFF" />
    </LinearLayout>

    <!-- 人机对战（玩家黑） -->
    <LinearLayout
        android:id="@+id/mode_2_button"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_mode_pvai_black"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="人机对战（玩家黑）"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶"
            android:textSize="14sp"
            android:textColor="#88FFFFFF" />
    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#E8E8E8"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="16dp" />

    <!-- 分区标题: 其它模式 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="其  它  模  式"
        android:textSize="11sp"
        android:textColor="#BBBBBB"
        android:letterSpacing="0.2"
        android:gravity="center"
        android:layout_marginBottom="10dp" />

    <!-- 双人对战 -->
    <LinearLayout
        android:id="@+id/mode_0_button"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_mode_pvp"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="双人对战"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶"
            android:textSize="14sp"
            android:textColor="#88FFFFFF" />
    </LinearLayout>

    <!-- 双机对战 -->
    <LinearLayout
        android:id="@+id/mode_3_button"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_mode_aivai"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="双机对战"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶"
            android:textSize="14sp"
            android:textColor="#88FFFFFF" />
    </LinearLayout>

    <!-- 取消按钮 -->
    <LinearLayout
        android:id="@+id/cancel_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_mode_cancel_btn"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取  消"
            android:textSize="15sp"
            android:textColor="#888888"
            android:letterSpacing="0.2" />
    </LinearLayout>

</LinearLayout>
