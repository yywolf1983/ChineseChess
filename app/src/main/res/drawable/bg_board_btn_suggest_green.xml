<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <!-- 支招识别色：亮绿（与双人模式原色互换），提亮增活 -->
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#74D49A"
                android:centerColor="#4AA34E"
                android:endColor="#317234" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#8CD690" />
        </shape>
    </item>
</ripple>
