<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 暖木控制面板：以 boardBrownDark 为基调的深木渐变，呼应上方 round 信息条的木色边框，
         消除与冷色按钮区的割裂感 -->
    <gradient
        android:angle="135"
        android:startColor="#4A3526"
        android:endColor="#2E2018"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#8A6A45" />
    <corners android:radius="12dp" />
</shape>
