<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 暖木控制面板：以 boardBrownDark 为基调的深木渐变，呼应上方 round 信息条的木色边框 -->
    <gradient
        android:angle="135"
        android:startColor="#56402D"
        android:endColor="#362519"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#A07C4E" />
    <corners android:radius="12dp" />
</shape>
