<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 与评分曲线同款的深色渐变，使按钮区与曲线成为同一视觉族 -->
    <gradient
        android:angle="135"
        android:startColor="#1E2B3A"
        android:endColor="#131C27"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#3A5570" />
    <corners android:radius="12dp" />
</shape>
