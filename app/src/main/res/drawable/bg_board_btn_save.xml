<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#CE8842"
                android:centerColor="#B0682F"
                android:endColor="#945E26" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#F2C282" />
        </shape>
    </item>
</ripple>
