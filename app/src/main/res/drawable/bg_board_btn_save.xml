<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#B07238"
                android:centerColor="#94602C"
                android:endColor="#7A4C20" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#D6A468" />
        </shape>
    </item>
</ripple>
