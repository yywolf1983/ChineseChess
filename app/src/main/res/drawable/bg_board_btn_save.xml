<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#A86A38"
                android:centerColor="#8A5226"
                android:endColor="#6E4220" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#D0A060" />
        </shape>
    </item>
</ripple>
