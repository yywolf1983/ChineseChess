<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#7A5236"
                android:centerColor="#62412A"
                android:endColor="#4E3320" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#A87B45" />
        </shape>
    </item>
</ripple>
