<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#8A6A45"
                android:centerColor="#6E5238"
                android:endColor="#563C26" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#B5894F" />
        </shape>
    </item>
</ripple>
