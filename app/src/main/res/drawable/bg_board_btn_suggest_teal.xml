<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <!-- 支招保留识别色，但改为暖绿（去冷调），与木金家族协调 -->
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#6E9A78"
                android:centerColor="#52805F"
                android:endColor="#3F6E50" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#9AC8A8" />
        </shape>
    </item>
</ripple>
