<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#3E8E7F"
                android:centerColor="#2F7268"
                android:endColor="#235A53" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#56AB9C" />
        </shape>
    </item>
</ripple>
