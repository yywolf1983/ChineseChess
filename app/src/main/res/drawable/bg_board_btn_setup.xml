<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#A07C52"
                android:centerColor="#82623E"
                android:endColor="#5E4128" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#D6AE72" />
        </shape>
    </item>
</ripple>
