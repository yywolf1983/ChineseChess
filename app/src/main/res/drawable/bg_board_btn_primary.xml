<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#3E6098"
                android:centerColor="#33517F"
                android:endColor="#264062" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#5680B0" />
        </shape>
    </item>
</ripple>
