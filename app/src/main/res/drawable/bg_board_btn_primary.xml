<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#F4D283"
                android:centerColor="#D9A64E"
                android:endColor="#BE8A3C" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#FFE9B8" />
        </shape>
    </item>
</ripple>
