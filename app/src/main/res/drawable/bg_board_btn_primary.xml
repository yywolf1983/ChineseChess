<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#D4A05A"
                android:centerColor="#B67E3A"
                android:endColor="#A06A2E" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#F0C888" />
        </shape>
    </item>
</ripple>
