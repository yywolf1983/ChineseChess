<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#E6BC72"
                android:centerColor="#C89650"
                android:endColor="#B07E38" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#F2D49A" />
        </shape>
    </item>
</ripple>
