<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#8A4A33"
                android:centerColor="#6E3A28"
                android:endColor="#5C3022" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#C8805A" />
        </shape>
    </item>
</ripple>
