<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#A8543C"
                android:centerColor="#8A3E2A"
                android:endColor="#6E3424" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#D08868" />
        </shape>
    </item>
</ripple>
