<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#C86046"
                android:centerColor="#A8482F"
                android:endColor="#833A28" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#EE9E80" />
        </shape>
    </item>
</ripple>
