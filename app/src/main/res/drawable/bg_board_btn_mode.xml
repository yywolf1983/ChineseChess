<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#B04634"
                android:centerColor="#8E3326"
                android:endColor="#6E2319" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#E08A6A" />
        </shape>
    </item>
</ripple>
