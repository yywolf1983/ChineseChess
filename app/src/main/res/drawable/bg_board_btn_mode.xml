<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#5E4368"
                android:centerColor="#4A3458"
                android:endColor="#3C2C4A" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#9A78A8" />
        </shape>
    </item>
</ripple>
