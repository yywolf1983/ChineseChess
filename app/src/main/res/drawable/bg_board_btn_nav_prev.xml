<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="135"
                        android:startColor="#846240"
                        android:endColor="#523A28" />
                    <corners android:radius="10dp" />
                    <stroke android:width="1dp" android:color="#CC9A62" />
                </shape>
            </item>
            <item
                android:width="24dp"
                android:height="24dp"
                android:drawable="@drawable/ic_prev"
                android:tint="#FFFFFF"
                android:gravity="center" />
        </layer-list>
    </item>
</ripple>
