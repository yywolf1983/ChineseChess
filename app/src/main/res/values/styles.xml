<resources>

    <style name="CustomDialog" parent="android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="ModePickerBottomSheet" parent="CustomDialog">
        <item name="android:windowAnimationStyle">@style/ModePickerAnim</item>
    </style>

    <style name="ModePickerAnim">
        <item name="android:windowEnterAnimation">@anim/slide_in_up</item>
        <item name="android:windowExitAnimation">@anim/slide_out_down</item>
    </style>

    <!-- 应用主主题：无 ActionBar，状态栏配色与木色棋盘协调 -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/boardBrown</item>
        <item name="colorPrimaryDark">@color/boardBrownDark</item>
        <item name="colorAccent">@color/boardAccent</item>
        <item name="android:statusBarColor">@color/boardBrownDark</item>
    </style>

</resources>
